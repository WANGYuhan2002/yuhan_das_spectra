# ---------------------------------------------------------------------------
# yuhan_das_spectra (GitHub version of check_minmag_pkg)
# Raw DAS data, intermediate PSD h5 files and recomputed run outputs are not
# committed; large intermediate samples are in the Zenodo archive
# 10.5281/zenodo.20715241 (matched_filter_release.zip -> check_minmag_pkg/).
# Files that ARE shipped on purpose are re-included with "!" rules below.
# ---------------------------------------------------------------------------

# --- Python caches, builds, environments -----------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/
.venv/
venv/
.env

# --- OS / editor junk -------------------------------------------------------
.DS_Store
._*
__MACOSX/
Thumbs.db
desktop.ini
*~
*.swp
.~lock.*#
.idea/
.vscode/

